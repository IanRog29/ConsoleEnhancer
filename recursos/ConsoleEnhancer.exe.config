<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- ConsoleEnhancer (20-11-2026, de Prisma CIERRES): un fallo no controlado en un hilo secundario acaba ese hilo y va al log
         (datos\logs\consoleenhancer.log), pero no cierra la app. Sin este fichero, como .NET 4 de serie: el proceso entero se cierra.
         build.bat y scripts\empaquetar.ps1 lo ponen junto a ConsoleEnhancer.exe.
         An unhandled exception in a background thread ends that thread and is logged, but does not close the app. -->
    <legacyUnhandledExceptionPolicy enabled="1"/>
  </runtime>
</configuration>
